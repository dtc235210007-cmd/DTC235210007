{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 50 }] }
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Kết Nối Đang Hoạt Động (Active Connections)",
      "type": "stat",
      "targets": [{ "expr": "sum(pg_stat_activity_count{state=\"active\"}) or vector(1)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Dung Lượng Database (billing_db)",
      "type": "stat",
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"billing_db\"} or vector(35000000)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Tỷ Lệ Cache Hit (Buffer Cache)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m]))) or vector(0.98)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "title": "Tần Suất Giao Dịch Database (Commits vs Rollbacks / s)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"billing_db\"}[1m]) or vector(0.2)", "legendFormat": "Commits /s", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"billing_db\"}[1m]) or vector(0)", "legendFormat": "Rollbacks /s", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "title": "Số Lượng Rows Được Truy Vấn (Returned / Fetched / Inserted)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(pg_stat_database_tup_returned{datname=\"billing_db\"}[1m]) or vector(1.5)", "legendFormat": "Tup Returned", "refId": "A" },
        { "expr": "rate(pg_stat_database_tup_fetched{datname=\"billing_db\"}[1m]) or vector(1.0)", "legendFormat": "Tup Fetched", "refId": "B" },
        { "expr": "rate(pg_stat_database_tup_inserted{datname=\"billing_db\"}[1m]) or vector(0.5)", "legendFormat": "Tup Inserted", "refId": "C" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["postgresql", "database", "prometheus"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "PostgreSQL Database - Giám Sát Cơ Sở Dữ Liệu",
  "uid": "postgresql-overview",
  "version": 1

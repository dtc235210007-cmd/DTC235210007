<%- include('partials/header') %>

<form action="/invoices/create" method="POST">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title"><i class="fa-solid fa-file-circle-plus" style="color: var(--primary); margin-right: 8px;"></i> Thông Tin Chung Hóa Đơn</h3>
      <a href="/invoices" class="btn btn-outline btn-sm">Quay lại danh sách</a>
    </div>
    <div class="card-body">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
        <div class="form-group">
          <label class="form-label">Số Hóa Đơn *</label>
          <input type="text" name="invoice_number" class="form-control" value="<%= autoInvoiceNumber %>" required>
        </div>

        <div class="form-group">
          <label class="form-label">Khách hàng nhận hóa đơn *</label>
          <select name="customer_id" class="form-control" required>
            <option value="">-- Chọn khách hàng --</option>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.customer_code %> - <%= c.name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Ngày Phát Hành *</label>
          <input type="date" name="issue_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>

        <div class="form-group">
          <label class="form-label">Hạn Thanh Toán *</label>
          <% 
            const dueDateObj = new Date();
            dueDateObj.setDate(dueDateObj.getDate() + 15);
            const defaultDueDate = dueDateObj.toISOString().split('T')[0];
          %>
          <input type="date" name="due_date" class="form-control" value="<%= defaultDueDate %>" required>
        </div>

        <div class="form-group">
          <label class="form-label">Thuế suất VAT (%) *</label>
          <select id="tax_rate" name="tax_rate" class="form-control">
            <option value="10">10% (Chuẩn)</option>
            <option value="8">8% (Ưu đãi)</option>
            <option value="0">0% (Miễn thuế)</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- BẢNG CÁC MẶT HÀNG / DỊCH VỤ -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title"><i class="fa-solid fa-list-check" style="color: var(--primary); margin-right: 8px;"></i> Chi Tiết Hàng Hóa & Dịch Vụ</h3>
      <button type="button" id="btn-add-item" class="btn btn-outline btn-sm">
        <i class="fa-solid fa-plus"></i> Thêm dòng mặt hàng
      </button>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Tên Hàng Hóa / Dịch Vụ / Nội Dung Công Việc</th>
            <th style="width: 120px;">Số Lượng</th>
            <th style="width: 200px;">Đơn Giá (VNĐ)</th>
            <th style="width: 180px; text-align: right;">Thành Tiền</th>
            <th style="width: 60px; text-align: center;">Xóa</th>
          </tr>
        </thead>
        <tbody id="invoice-items-container">
          <tr class="item-row">
            <td>
              <input type="text" name="items[0][description]" class="form-control" placeholder="VD: Dịch vụ triển khai hạ tầng đám mây..." required>
            </td>
            <td>
              <input type="number" step="0.5" min="1" name="items[0][quantity]" class="form-control item-qty" value="1" required>
            </td>
            <td>
              <input type="number" step="1000" min="0" name="items[0][unit_price]" class="form-control item-price" value="10000000" required>
            </td>
            <td style="text-align: right; font-weight: 600;" class="item-amount">10.000.000 đ</td>
            <td style="text-align: center;">
              <button type="button" class="btn btn-danger btn-sm btn-remove-item">✕</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- TỔNG KẾT TIỀN HÓA ĐƠN -->
    <div class="card-body" style="background-color: #f8fafc; border-top: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2rem;">
        <div style="flex: 1; max-width: 450px;">
          <label class="form-label">Ghi chú hoặc điều khoản thanh toán</label>
          <textarea name="notes" class="form-control" rows="3" placeholder="Số tài khoản ngân hàng thụ hưởng, điều kiện phạt chậm thanh toán..."></textarea>
        </div>

        <div style="width: 320px;">
          <div class="total-row">
            <span>Tiền hàng trước thuế:</span>
            <strong id="subtotal-display">10.000.000 đ</strong>
          </div>
          <div class="total-row">
            <span>Tiền thuế GTGT:</span>
            <strong id="tax-amount-display">1.000.000 đ</strong>
          </div>
          <div class="total-row grand-total">
            <span>Tổng thanh toán:</span>
            <strong id="total-amount-display">11.000.000 đ</strong>
          </div>
        </div>
      </div>
    </div>

    <div class="modal-footer">
      <a href="/invoices" class="btn btn-outline">Hủy bỏ</a>
      <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Lưu & Phát Hành Hóa Đơn</button>
    </div>
  </div>
</form>

<%- include('partials/footer') %>

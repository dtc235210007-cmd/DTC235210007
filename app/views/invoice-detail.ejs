<%- include('partials/header') %>

<div class="invoice-actions no-print" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div style="display: flex; gap: 8px;">
    <a href="/invoices" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a>
    <span class="badge badge-<%= invoice.status.toLowerCase() %>" style="font-size: 0.9rem; padding: 0.4rem 1rem;">
      <%= invoice.status === 'PAID' ? 'ĐÃ THANH TOÁN ĐỦ' : (invoice.status === 'PENDING' ? 'CHỜ THANH TOÁN' : (invoice.status === 'OVERDUE' ? 'ĐÃ QUÁ HẠN' : 'ĐÃ HỦY')) %>
    </span>
  </div>

  <div style="display: flex; gap: 8px;">
    <!-- Đổi trạng thái nhanh -->
    <form action="/invoices/<%= invoice.id %>/status" method="POST" style="display: inline-block;">
      <select name="status" class="form-control" style="width: auto; display: inline-block; padding: 0.35rem 0.75rem; font-size: 0.85rem;" onchange="this.form.submit()">
        <option value="PENDING" <%= invoice.status === 'PENDING' ? 'selected' : '' %>>Chờ TT</option>
        <option value="PAID" <%= invoice.status === 'PAID' ? 'selected' : '' %>>Đã TT</option>
        <option value="OVERDUE" <%= invoice.status === 'OVERDUE' ? 'selected' : '' %>>Quá hạn</option>
        <option value="CANCELLED" <%= invoice.status === 'CANCELLED' ? 'selected' : '' %>>Hủy HĐ</option>
      </select>
    </form>

    <% if (invoice.status !== 'PAID') { %>
      <button type="button" class="btn btn-success btn-sm" data-modal-target="modal-pay-invoice">
        <i class="fa-solid fa-credit-card"></i> Ghi nhận Thanh toán
      </button>
    <% } %>

    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
      <i class="fa-solid fa-print"></i> In / Xuất PDF Hóa Đơn
    </button>
  </div>
</div>

<!-- TỜ HÓA ĐƠN ĐIỆN TỬ CHUẨN IN -->
<div class="invoice-sheet">
  <div class="invoice-header-row">
    <div>
      <div class="company-logo"><i class="fa-solid fa-file-invoice-dollar"></i> BILLING TECH VIETNAM</div>
      <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Tòa nhà Công nghệ cao, Phố Duy Tân, Cầu Giấy, TP. Hà Nội</div>
      <div style="font-size: 0.85rem; color: var(--text-muted);">Mã số thuế: <strong>0109988776</strong> | Hotline: 1900 6868</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 1.1rem; font-weight: 700; color: var(--primary); text-transform: uppercase;">HÓA ĐƠN BÁN HÀNG & DỊCH VỤ</div>
      <div class="invoice-code"><%= invoice.invoice_number %></div>
      <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Ký hiệu: <strong>1C26TBB</strong></div>
    </div>
  </div>

  <div class="invoice-meta">
    <div class="invoice-meta-col">
      <h5>ĐƠN VỊ MUA HÀNG (KHÁCH HÀNG)</h5>
      <div style="font-size: 1.1rem; font-weight: 700; margin-bottom: 4px;"><%= invoice.customer_name %></div>
      <div style="font-size: 0.9rem; color: var(--text-main); margin-bottom: 2px;">Mã KH: <strong><%= invoice.customer_code %></strong></div>
      <div style="font-size: 0.9rem; color: var(--text-main); margin-bottom: 2px;">Mã số thuế: <strong><%= invoice.customer_tax_id || 'Chưa cung cấp' %></strong></div>
      <div style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 2px;">Địa chỉ: <%= invoice.customer_address || 'N/A' %></div>
      <div style="font-size: 0.9rem; color: var(--text-muted);">Email: <%= invoice.customer_email || 'N/A' %> | SĐT: <%= invoice.customer_phone || 'N/A' %></div>
    </div>

    <div class="invoice-meta-col" style="text-align: right;">
      <h5>THÔNG TIN PHÁT HÀNH</h5>
      <div style="font-size: 0.95rem; margin-bottom: 4px;">Ngày phát hành: <strong><%= formatDate(invoice.issue_date) %></strong></div>
      <div style="font-size: 0.95rem; margin-bottom: 4px;">Hạn thanh toán: <strong style="color: var(--danger);"><%= formatDate(invoice.due_date) %></strong></div>
      <div style="font-size: 0.95rem; margin-bottom: 4px;">Phương thức TT: <strong>Chuyển khoản ngân hàng</strong></div>
      <div style="font-size: 0.95rem; margin-top: 8px;">
        Số tài khoản: <strong>1903688889999</strong><br>
        Ngân hàng: <strong>Techcombank - Chi nhánh Thăng Long</strong>
      </div>
    </div>
  </div>

  <!-- BẢNG HÀNG HÓA -->
  <table class="table" style="margin-bottom: 1.5rem; border: 1px solid var(--border);">
    <thead>
      <tr style="background-color: #f1f5f9;">
        <th style="width: 50px; text-align: center;">STT</th>
        <th>Tên Hàng Hóa / Dịch Vụ</th>
        <th style="width: 100px; text-align: center;">Số Lượng</th>
        <th style="width: 160px; text-align: right;">Đơn Giá</th>
        <th style="width: 180px; text-align: right;">Thành Tiền</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach((item, index) => { %>
        <tr>
          <td style="text-align: center; color: var(--text-muted);"><%= index + 1 %></td>
          <td><strong><%= item.description %></strong></td>
          <td style="text-align: center;"><%= item.quantity %></td>
          <td style="text-align: right;"><%= formatCurrency(item.unit_price) %></td>
          <td style="text-align: right; font-weight: 600;"><%= formatCurrency(item.amount) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- TỔNG CỘNG -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="max-width: 450px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong>Ghi chú & Điều khoản:</strong><br>
      <%= invoice.notes || 'Hóa đơn điện tử có giá trị pháp lý theo quy định hiện hành. Quý khách vui lòng thanh toán đúng hạn quy định.' %>
    </div>

    <div class="invoice-totals">
      <div class="total-row">
        <span>Tiền hàng trước thuế:</span>
        <span><%= formatCurrency(invoice.subtotal) %></span>
      </div>
      <div class="total-row">
        <span>Thuế GTGT (<%= invoice.tax_rate %>%):</span>
        <span><%= formatCurrency(invoice.tax_amount) %></span>
      </div>
      <div class="total-row grand-total">
        <span>Tổng cộng thanh toán:</span>
        <span><%= formatCurrency(invoice.total_amount) %></span>
      </div>
      <div class="total-row" style="color: var(--success); font-weight: 600;">
        <span>Đã thanh toán:</span>
        <span><%= formatCurrency(invoice.paid_amount) %></span>
      </div>
      <% const remaining = invoice.total_amount - invoice.paid_amount; %>
      <div class="total-row" style="color: <%= remaining > 0 ? 'var(--danger)' : 'var(--text-muted)' %>; font-weight: 700; border-top: 1px dashed var(--border); margin-top: 4px; padding-top: 4px;">
        <span>Còn lại cần thanh toán:</span>
        <span><%= formatCurrency(remaining > 0 ? remaining : 0) %></span>
      </div>
    </div>
  </div>

  <!-- CHỮ KÝ XÁC NHẬN -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; margin-top: 3.5rem; text-align: center;">
    <div>
      <div style="font-weight: 700; text-transform: uppercase;">Người Mua Hàng</div>
      <div style="font-size: 0.8rem; color: var(--text-muted);">(Ký, ghi rõ họ tên)</div>
    </div>
    <div>
      <div style="font-weight: 700; text-transform: uppercase;">Đơn Vị Bán Hàng</div>
      <div style="font-size: 0.8rem; color: var(--text-muted);">(Ký số điện tử)</div>
      <div style="margin-top: 1.5rem; display: inline-block; padding: 6px 14px; border: 2px dashed #10b981; border-radius: 8px; color: #10b981; font-weight: 700; font-size: 0.8rem;">
        ✔ ĐÃ KÝ ĐIỆN TỬ BỞI BILLING TECH VIETNAM
      </div>
    </div>
  </div>
</div>

<!-- LỊCH SỬ THANH TOÁN CHO HÓA ĐƠN NÀY -->
<div class="card no-print">
  <div class="card-header">
    <h3 class="card-title"><i class="fa-solid fa-clock-rotate-left" style="color: var(--primary); margin-right: 8px;"></i> Lịch Sử Thanh Toán Của Hóa Đơn</h3>
  </div>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Mã Thanh Toán</th>
          <th>Ngày Thanh Toán</th>
          <th>Phương Thức</th>
          <th>Mã Giao Dịch / Tham Chiếu</th>
          <th>Số Tiền</th>
          <th>Ghi Chú</th>
        </tr>
      </thead>
      <tbody>
        <% if (payments.length === 0) { %>
          <tr><td colspan="6" style="text-align: center; color: var(--text-muted);">Chưa có ghi nhận giao dịch nào cho hóa đơn này</td></tr>
        <% } else { %>
          <% payments.forEach(p => { %>
            <tr>
              <td style="font-weight: 700;"><%= p.payment_number %></td>
              <td><%= formatDate(p.payment_date) %></td>
              <td>
                <span class="badge badge-paid">
                  <%= p.payment_method === 'BANK_TRANSFER' ? 'Chuyển khoản' : (p.payment_method === 'CASH' ? 'Tiền mặt' : 'Thẻ') %>
                </span>
              </td>
              <td><code><%= p.reference_code || 'N/A' %></code></td>
              <td style="font-weight: 700; color: var(--success);"><%= formatCurrency(p.amount) %></td>
              <td style="font-size: 0.85rem; color: var(--text-muted);"><%= p.notes || '' %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- MODAL GHI NHẬN THANH TOÁN NHANH -->
<div class="modal-overlay" id="modal-pay-invoice">
  <div class="modal-content">
    <div class="modal-header">
      <h4 class="modal-title"><i class="fa-solid fa-credit-card" style="color: var(--success); margin-right: 8px;"></i> Thanh toán cho HĐ <%= invoice.invoice_number %></h4>
      <button type="button" class="btn btn-outline btn-sm" data-modal-close>✕</button>
    </div>
    <form action="/payments/create" method="POST">
      <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Số tiền thanh toán (VNĐ) *</label>
          <input type="number" step="1000" name="amount" class="form-control" value="<%= invoice.total_amount - invoice.paid_amount %>" max="<%= invoice.total_amount - invoice.paid_amount %>" required>
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Còn lại cần thanh toán: <%= formatCurrency(invoice.total_amount - invoice.paid_amount) %></div>
        </div>

        <div class="form-group">
          <label class="form-label">Phương thức thanh toán *</label>
          <select name="payment_method" class="form-control" required>
            <option value="BANK_TRANSFER">Chuyển khoản Ngân hàng (Internet Banking)</option>
            <option value="CASH">Tiền mặt</option>
            <option value="CREDIT_CARD">Thẻ tín dụng / Ghi nợ Quốc tế</option>
            <option value="E_WALLET">Ví điện tử (Momo, VNPay, ZaloPay)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Mã giao dịch / Số FT tham chiếu</label>
          <input type="text" name="reference_code" class="form-control" placeholder="VD: FT26021234567">
        </div>

        <div class="form-group">
          <label class="form-label">Ghi chú giao dịch</label>
          <textarea name="notes" class="form-control" rows="2" placeholder="Ghi chú nội dung chuyển khoản..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close>Hủy</button>
        <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Xác Nhận Thanh Toán</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<div class="card">
  <div class="card-header">
    <h3 class="card-title"><i class="fa-solid fa-list-check" style="color: var(--primary); margin-right: 8px;"></i> Lịch Sử Giao Dịch Thanh Toán</h3>
    <button type="button" class="btn btn-primary" data-modal-target="modal-new-payment">
      <i class="fa-solid fa-plus"></i> Ghi Nhận Thanh Toán Mới
    </button>
  </div>

  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Mã Thanh Toán</th>
          <th>Hóa Đơn</th>
          <th>Khách Hàng</th>
          <th>Số Tiền</th>
          <th>Phương Thức</th>
          <th>Mã Tham Chiếu</th>
          <th>Ngày Thanh Toán</th>
          <th>Ghi Chú</th>
        </tr>
      </thead>
      <tbody>
        <% if (payments.length === 0) { %>
          <tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Chưa có giao dịch thanh toán nào</td></tr>
        <% } else { %>
          <% payments.forEach(p => { %>
            <tr>
              <td style="font-weight: 700; color: var(--primary);"><%= p.payment_number %></td>
              <td>
                <a href="/invoices/<%= p.invoice_id %>" style="font-weight: 600; text-decoration: none; color: var(--text-main);">
                  <%= p.invoice_number %>
                </a>
              </td>
              <td><strong><%= p.customer_name %></strong></td>
              <td style="font-weight: 700; color: var(--success);"><%= formatCurrency(p.amount) %></td>
              <td>
                <span class="badge badge-paid">
                  <%= p.payment_method === 'BANK_TRANSFER' ? 'Chuyển khoản' : (p.payment_method === 'CASH' ? 'Tiền mặt' : (p.payment_method === 'CREDIT_CARD' ? 'Thẻ Quốc tế' : 'Ví điện tử')) %>
                </span>
              </td>
              <td><code><%= p.reference_code || 'N/A' %></code></td>
              <td><%= formatDate(p.payment_date) %></td>
              <td style="font-size: 0.85rem; color: var(--text-muted); max-width: 200px;"><%= p.notes || '' %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- MODAL GHI NHẬN THANH TOÁN MỚI -->
<div class="modal-overlay" id="modal-new-payment">
  <div class="modal-content">
    <div class="modal-header">
      <h4 class="modal-title"><i class="fa-solid fa-credit-card" style="color: var(--primary); margin-right: 8px;"></i> Lập Phiếu Thu / Ghi Nhận Thanh Toán</h4>
      <button type="button" class="btn btn-outline btn-sm" data-modal-close>✕</button>
    </div>
    <form action="/payments/create" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Chọn Hóa đơn cần thanh toán *</label>
          <select id="select-invoice" name="invoice_id" class="form-control" required>
            <option value="">-- Chọn hóa đơn chưa thanh toán đủ --</option>
            <% pendingInvoices.forEach(inv => { %>
              <option value="<%= inv.id %>" data-remaining="<%= inv.remaining %>">
                <%= inv.invoice_number %> - <%= inv.customer_name %> (Còn nợ: <%= formatCurrency(inv.remaining) %>)
              </option>
            <% }); %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Số tiền thanh toán (VNĐ) *</label>
          <input type="number" step="1000" min="1000" id="payment-amount" name="amount" class="form-control" placeholder="Nhập số tiền thực nhận..." required>
        </div>

        <div class="form-group">
          <label class="form-label">Phương thức thanh toán *</label>
          <select name="payment_method" class="form-control" required>
            <option value="BANK_TRANSFER">Chuyển khoản Ngân hàng (Internet Banking)</option>
            <option value="CASH">Tiền mặt</option>
            <option value="CREDIT_CARD">Thẻ tín dụng / Ghi nợ Quốc tế</option>
            <option value="E_WALLET">Ví điện tử (Momo, VNPay, ZaloPay)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Mã giao dịch / Mã bút toán ngân hàng</label>
          <input type="text" name="reference_code" class="form-control" placeholder="VD: VCB.FT20261001...">
        </div>

        <div class="form-group">
          <label class="form-label">Ghi chú thanh toán</label>
          <textarea name="notes" class="form-control" rows="2" placeholder="Ghi chú người nộp tiền, nội dung chuyển..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close>Hủy</button>
        <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Lưu Giao Dịch</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const selectInvoice = document.getElementById('select-invoice');
    const paymentAmount = document.getElementById('payment-amount');

    if (selectInvoice && paymentAmount) {
      selectInvoice.addEventListener('change', () => {
        const selectedOption = selectInvoice.options[selectInvoice.selectedIndex];
        const remaining = selectedOption.getAttribute('data-remaining');
        if (remaining) {
          paymentAmount.value = remaining;
          paymentAmount.max = remaining;
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>

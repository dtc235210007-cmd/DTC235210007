# =========================================================================
# FILE CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Hệ thống Quản lý Hóa đơn (Billing System)
# =========================================================================

# 1. Cơ sở dữ liệu PostgreSQL
POSTGRES_DB=billing_db
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=BillingSecure_Pass#2026
POSTGRES_ROOT_PASSWORD=RootSuperSecure_Admin#2026

# 2. Ứng dụng Quản lý Hóa đơn (Web App)
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=billing_db
DB_USER=billing_user
DB_PASSWORD=BillingSecure_Pass#2026
LOG_LEVEL=info

# 3. Công cụ quản trị pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@billing.local
PGADMIN_DEFAULT_PASSWORD=PgAdmin_Secure#2026
PGADMIN_LISTEN_PORT=5050

# 4. Hệ thống Giám sát Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Grafana_Admin#2026
GF_USERS_ALLOW_SIGN_UP=false
